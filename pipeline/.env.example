# Copy to .env in the repository root (it is gitignored) and fill in.
#   cp pipeline/.env.example .env

# DataForSEO — base64 of "login:password", used verbatim as `Authorization: Basic <value>`.
# Powers Local presence, Visibility and AI search presence.
# Get it from https://app.dataforseo.com/api-access
#   printf '%s' 'you@example.com:yourpassword' | base64
DATAFORSEO_AUTH=

# Google PageSpeed Insights — optional. The Speed pillar works without a key in
# keyless low-rate mode, but a key avoids throttling across ~18 businesses.
# https://console.cloud.google.com  (enable "PageSpeed Insights API")
PAGESPEED_API_KEY=
